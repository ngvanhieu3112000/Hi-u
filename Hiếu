<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xí nghiệp Kinh doanh Nước sạch Hoàng Mai</title>
    <style>
        :root {
            --primary-color: #0056b3;
            --secondary-color: #17a2b8;
            --accent-color: #ffc107;
            --text-color: #333;
            --light-bg: #f8f9fa;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { color: var(--text-color); line-height: 1.6; }
        
        /* Header & Navigation */
        header { background: #fff; border-bottom: 3px solid var(--primary-color); padding: 15px 5%; display: flex; justify-content: space-between; align-items: center; }
        .logo-container { display: flex; align-items: center; gap: 15px; }
        .logo-icon { width: 50px; height: 50px; background: var(--primary-color); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 24px; }
        .brand-name h1 { font-size: 1.4rem; color: var(--primary-color); text-transform: uppercase; }
        .brand-name p { font-size: 0.85rem; color: #666; font-weight: 600; }
        
        nav { background: var(--primary-color); display: flex; padding: 0 5%; list-style: none; overflow-x: auto; }
        nav a { color: white; padding: 12px 20px; text-decoration: none; font-weight: 600; font-size: 0.95rem; white-space: nowrap; transition: 0.3s; }
        nav a:hover, nav a.active { background: #004085; background-color: var(--secondary-color); }

        /* Banner */
        .banner { background: linear-gradient(135deg, #0056b3 0%, #00a4ff 100%); color: white; padding: 60px 5%; text-align: center; }
        .banner h2 { font-size: 2.2rem; margin-bottom: 10px; }
        .banner p { font-size: 1.1rem; opacity: 0.9; }

        /* Quick Services Grid */
        .services-section { padding: 40px 5%; text-align: center; background: #fff; }
        .section-title { font-size: 1.8rem; color: var(--primary-color); margin-bottom: 30px; position: relative; padding-bottom: 10px; }
        .section-title::after { content: ''; width: 60px; height: 3px; background: var(--secondary-color); position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); }
        .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
        .service-card { background: var(--light-bg); border: 1px solid #eee; border-radius: 8px; padding: 25px 15px; text-decoration: none; color: var(--text-color); font-weight: 600; transition: transform 0.3s, box-shadow 0.3s; display: flex; flex-direction: column; align-items: center; gap: 15px; }
        .service-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); border-color: var(--primary-color); }
        .service-icon { font-size: 2.5rem; color: var(--primary-color); }

        /* Info Dashboard & News */
        .main-container { padding: 40px 5%; display: flex; flex-wrap: wrap; gap: 30px; background: var(--light-bg); }
        .news-block { flex: 2; min-width: 300px; background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .sidebar { flex: 1; min-width: 280px; display: flex; flex-direction: column; gap: 20px; }
        .sidebar-widget { background: white; padding: 20px; border-radius: 8px; border-left: 4px solid var(--secondary-color); box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .sidebar-widget h3 { color: var(--primary-color); margin-bottom: 15px; font-size: 1.1rem; text-transform: uppercase; border-bottom: 1px solid #eee; padding-bottom: 8px; }
        
        .news-item { padding: 15px 0; border-bottom: 1px dashed #eee; }
        .news-item:last-child { border: none; }
        .news-item a { color: var(--text-color); text-decoration: none; font-weight: 600; font-size: 1rem; }
        .news-item a:hover { color: var(--primary-color); }
        .news-date { font-size: 0.8rem; color: #888; margin-top: 5px; }

        /* Footer */
        footer { background: #222; color: #ccc; padding: 40px 5%; font-size: 0.9rem; }
        .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; margin-bottom: 30px; }
        .footer-col h4 { color: white; margin-bottom: 15px; text-transform: uppercase; font-size: 1rem; }
        .footer-col p { margin-bottom: 10px; }
        .footer-bottom { border-top: 1px solid #444; padding-top: 20px; text-align: center; font-size: 0.8rem; }
    </style>
</head>
